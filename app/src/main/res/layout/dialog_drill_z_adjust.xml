<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sfondo_dialog_chiara">
    <TextView
        android:id="@+id/tito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Z Adjust"
        android:gravity="center"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@id/tito"
        android:background="@color/bg_stonex_blue"
        />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottla"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.7"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tito"
        app:layout_constraintBottom_toTopOf="@id/bottla"
        android:orientation="horizontal"
        android:gravity="center"
        >
        <ImageView
            android:visibility="invisible"
            android:layout_marginHorizontal="25dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/sfondo_bottone_trasparente"
            android:src="@drawable/bottone_meno"
            />
        <ImageView
            android:id="@+id/btPiu"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/sfondo_bottone_trasparente"
           android:src="@drawable/bottone_piu"
            />
        <TextView
            android:id="@+id/valore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.000"
            android:gravity="center"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:ems="10"
            />
        <ImageView
            android:id="@+id/btMeno"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/sfondo_bottone_trasparente"
            android:src="@drawable/bottone_meno"
            />

        <ImageView
            android:id="@+id/btReset"
            android:layout_marginHorizontal="25dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/sfondo_bottone_trasparente"
            android:src="@drawable/btn_delete_forever"
            app:tint="@color/red_dark"
            />

    </LinearLayout>

    <ImageView
        android:id="@+id/close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/bottla"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:src="@drawable/btn_close_web"
        app:tint="@color/_____cancel_text"
        />
</androidx.constraintlayout.widget.ConstraintLayout>