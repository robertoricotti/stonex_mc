  <types>
    <dataTypes/>
    <pous>
      <pou name="FB_encriptTSM_Tool" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="acc_x">
              <type>
                <INT/>
              </type>
            </variable>
            <variable name="acc_y">
              <type>
                <INT/>
              </type>
            </variable>
            <variable name="acc_z">
              <type>
                <INT/>
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="pitch">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="roll">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="pitchInt">
              <type>
                <INT/>
              </type>
            </variable>
            <variable name="rollInt">
              <type>
                <INT/>
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="norm">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="ax_norm">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="ay_norm">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="az_norm">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="x_r">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="y_r">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="z_r">
              <type>
                <REAL/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <code xmlns="http://www.w3.org/1999/xhtml">


x_r := INT_TO_REAL(acc_x);
y_r := INT_TO_REAL(acc_y);
z_r := INT_TO_REAL(acc_z);

norm := SQRT(
    x_r * x_r +
    y_r * y_r +
    z_r * z_r
);

IF norm &gt; 0.0 THEN

    ax_norm := y_r / norm;
    ay_norm := x_r / norm;
    az_norm := z_r / norm;

    roll := ATAN2(
        ax_norm,
        SQRT(ay_norm * ay_norm + az_norm * az_norm)
    ) * 180.0 / 3.141592653589793;

    pitch := ATAN2(
        ay_norm,
        SQRT(ax_norm * ax_norm + az_norm * az_norm)
    ) * 180.0 / 3.141592653589793;
    
    rollInt:= REAL_TO_INT(roll*100)*-1;
    pitchInt:=REAL_TO_INT(pitch*100)*-1;

ELSE

    pitch := 0.0;
    roll  := 0.0;
    
    pitchInt:=0;
    rollInt:=0;

END_IF;</code>
          </ST>
        </body>
        <addData>
          <data name="InterfaceText" handleUnknown="discard">
            <code>FUNCTION_BLOCK FB_encriptTSM_Tool
VAR_INPUT
  acc_x : INT;
  acc_y : INT;
  acc_z : INT;
END_VAR
VAR_OUTPUT
  pitch : REAL;
  roll : REAL;
  pitchInt : INT;
  rollInt : INT;
END_VAR
VAR
  norm : REAL;
  ax_norm : REAL;
  ay_norm : REAL;
  az_norm : REAL;
  x_r : REAL;
  y_r : REAL;
  z_r : REAL;
END_VAR

</code>
          </data>
          <data name="notYetVerified" handleUnknown="discard">False</data>
        </addData>
      </pou>
